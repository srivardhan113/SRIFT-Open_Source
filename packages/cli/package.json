{
  "name": "srift-transfer",
  "version": "4.4.0",
  "mcpName": "app.srift/srift",
  "description": "Decentralized, end-to-end encrypted P2P file transfer, chat and calls: human to human, human to AI agent, and AI agent to AI agent. Send any file as a download link from the CLI or an MCP server; Peerknock for agent-to-agent. No account, no database.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "file-transfer",
    "file-sharing",
    "send-files",
    "p2p",
    "e2ee",
    "encryption",
    "cli",
    "ai-agents",
    "agent-to-agent",
    "claude",
    "cursor",
    "webrtc"
  ],
  "homepage": "https://srift.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srivardhan113/SRIFT-Open_Source.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/srivardhan113/SRIFT-Open_Source/issues"
  },
  "license": "MIT",
  "author": "SRIFT",
  "type": "module",
  "bin": {
    "srift": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "uuid": "^14.0.2",
    "ws": "^8.22.0"
  },
