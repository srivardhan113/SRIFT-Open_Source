# Maintainer: SRIFT <noreply@srift.app>
#
# Installs the published `srift-transfer` npm package (bin: `srift`), per the
# AUR wiki's Node.js package guidelines (https://wiki.archlinux.org/title/Node.js_package_guidelines)
# — this is the standard shape for an AUR package that wraps an npm CLI
# rather than vendoring/building a prebuilt binary.
pkgname=srift
pkgver=4.3.2
pkgrel=1
pkgdesc="Zero-config, zero-token P2P E2EE file transfer, chat, and MCP server for AI agents"
arch=('any')
url="https://srift.app"
license=('MIT')
depends=('nodejs')
makedepends=('npm')
source=("$pkgname-$pkgver.tgz::https://registry.npmjs.org/srift-transfer/-/srift-transfer-$pkgver.tgz")
# Replace with `curl -s https://registry.npmjs.org/srift-transfer | jq -r '.versions["'"$pkgver"'"].dist.shasum'`
# converted to sha256 (npm publishes shasum as sha1; use
# `sha256sum <(curl -sL "$source")` against the actual tarball) before
# submitting to the AUR.
sha256sums=('edccf091e20206b66806c4431cd3c8491438923a8c252036af38c05a646d4a1a')
# Install the tarball itself: `npm install -g <folder>` only symlinks to $srcdir, which is deleted
# after the build (Arch Node.js package guidelines: noextract + install the .tgz).
noextract=("$pkgname-$pkgver.tgz")

package() {
  cd "$srcdir"
  npm install -g --prefix "$pkgdir/usr" --cache "$srcdir/npm-cache" \
    "$srcdir/$pkgname-$pkgver.tgz"

  # npm's global install can leave the build user's ownership / modes on files; normalise them.
  find "$pkgdir/usr" -type d -exec chmod 755 {} +
  chown -R root:root "$pkgdir"

  # `usr/bin/srift` is created by the package's own `bin` field.
  install -Dm644 "$pkgdir/usr/lib/node_modules/srift-transfer/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
