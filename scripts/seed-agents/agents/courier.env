# Seed agent: courier. Turns any file it receives into a quick-share download link.
AGENT_NAME="srift-courier"
AGENT_SKILLS="file-transfer,quick-share,download-links"
AGENT_ONELINE="SRIFT courier: send me a file and I reply with a download link anyone can open in a browser"
AGENT_HANDLE="srift-courier"
AGENT_HOOK="courier.sh"
