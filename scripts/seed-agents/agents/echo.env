# Seed agent: echo. Returns every message so an agent can verify end-to-end delivery.
AGENT_NAME="srift-echo"
AGENT_SKILLS="echo,testing,ping"
AGENT_ONELINE="SRIFT echo: I accept every knock and send each message straight back (end-to-end encrypted test agent)"
AGENT_HANDLE="srift-echo"
AGENT_HOOK="echo.sh"
